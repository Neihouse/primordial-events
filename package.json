{
  "name": "with-vercel-postgres",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "download-images": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/download-equipment-images.ts",
    "update-equipment-images": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/update-equipment-images.ts",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed:gallery": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/seed-gallery.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "ci": "payload migrate && pnpm build",
    "tasks:dry": "./scripts/run-tasks.sh dry-run",
    "tasks:run": "./scripts/run-tasks.sh",
    "tasks:auto": "./scripts/run-tasks.sh auto",
    "outreach": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/outreach-automation.ts",
    "outreach:help": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/outreach-automation.ts help",
    "outreach:list": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/outreach-automation.ts list",
    "outreach:report": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/outreach-automation.ts report --all"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@modelcontextprotocol/sdk": "1.25.2",
    "@payloadcms/db-vercel-postgres": "3.76.1",
    "@payloadcms/next": "3.76.1",
    "@payloadcms/plugin-mcp": "^3.76.1",
    "@payloadcms/richtext-lexical": "3.76.1",
    "@payloadcms/storage-vercel-blob": "3.76.1",
    "@payloadcms/ui": "3.76.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "lucide-react": "^0.563.0",
    "next": "15.4.11",
    "payload": "3.76.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.71.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.56.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.4.11",
    "jsdom": "28.0.0",
    "playwright": "1.56.1",
    "playwright-core": "1.56.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.28.2"
}
